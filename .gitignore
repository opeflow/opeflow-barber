# Segredos e configurações locais
.env
.env.*
!.env.example
!.env.testing.example

# Dependências
/vendor/
/node_modules/

# Saídas de build e desenvolvimento
/public/build/
/public/hot
/public/storage
/.vite/

# Arquivos e caches gerados pelo Laravel
/bootstrap/cache/*.php
/storage/*.key
/storage/framework/cache/data/**
/storage/framework/sessions/**
/storage/framework/testing/**
/storage/framework/views/**
/storage/logs/**
/storage/app/private/**
/storage/app/public/**
!/storage/app/private/.gitignore
!/storage/app/public/.gitignore

# Testes e cobertura
/.phpunit.cache/
/coverage/
/build/

# Logs e arquivos temporários do Node/npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editor e sistema operacional
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini
